# 仅示例，复制为 .env.local 后修改
# 站点部署在子路径时改成 /<repo>/（GitHub 项目页），用户主页仓库用 /
VITE_BASE=/
# 站点域名（只填 origin，不含子路径），用于 sitemap / robots
VITE_SITE_URL=https://example.com
# 前台口令哈希（默认口令 admin123 的 sha256；上线前务必替换）
VITE_ADMIN_PASS_HASH=
# 统计上报地址（Cloudflare Worker），留空则统计只写入本地库
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_SAMPLE=1.0
# 后台云端数据源地址（只放 URL，不放 Token；Token 在 /admin/connect 输入并仅存本机）
VITE_TURSO_URL=
# 一键发布：GitHub Actions workflow_dispatch
# Token 会进入前端构建产物，公开站点不要配置；CI 需 ALLOW_BROWSER_PUBLISH=true 才会注入
VITE_GH_REPO=
VITE_GH_TOKEN=
VITE_GH_BRANCH=main
VITE_GH_WORKFLOW=deploy.yml
